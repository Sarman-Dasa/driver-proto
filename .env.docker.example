APP_NAME=BillFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Docker container logging (stderr outputs directly to docker logs)
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose Port Forwarding
APP_PORT=8000
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6379

# Database Configuration (matches Docker Compose `db` service)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=billflow
DB_USERNAME=billflow
DB_PASSWORD=billflow_secret
DB_ROOT_PASSWORD=root_secret

# Session & Cache (database by default)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# Queue Worker Configuration
# Default connection is database. If using Redis, change to 'redis'.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
QUEUE_TIMEOUT=90
QUEUE_TRIES=3
QUEUE_SLEEP=3

# Redis Configuration (matches Docker Compose `redis` service)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=120

# Authentication & Sanctum
SANCTUM_TOKEN_EXPIRATION=1440
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# Filesystem & Broadcasting
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@billflow.local"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe SaaS Configuration
STRIPE_KEY=pk_test_placeholder
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_placeholder

# Frontend
VITE_APP_NAME="${APP_NAME}"

